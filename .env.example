# ─── LLM Configuration ────────────────────────────────────────────────────────
# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# OpenAI API key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# xAI (Grok) API key (get from https://console.x.ai)
XAI_API_KEY=your_xai_api_key_here

# DeepSeek API key (get from https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# LLM provider priority: "auto" | "gemini" | "openai" | "grok" | "deepseek" | "ollama"
# "auto" = Grok > DeepSeek > OpenAI > Gemini > Ollama
LLM_PROVIDER=auto

# Ollama base URL (default: local install; change if running in Docker)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://rdtii_user:rdtii_pass@localhost:5432/rdtii_db
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://rdtii_user:rdtii_pass@localhost:5432/rdtii_db

# ─── Redis / Celery ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:3000

# ─── Search ────────────────────────────────────────────────────────────────────
# Tavily API key (get from https://app.tavily.com) — primary search engine for web discovery
TAVILY_API_KEY=
MAX_SEARCH_RESULTS_PER_QUERY=10
MAX_QUERIES_PER_INDICATOR=7
DOWNLOAD_TIMEOUT_SECONDS=30
MAX_DOCUMENT_SIZE_MB=50
